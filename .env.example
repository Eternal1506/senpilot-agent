# Copy to .env and fill in values

# Set false while developing so you can watch the browser
HEADLESS=true

# How often to poll the inbox (seconds)
POLL_INTERVAL_SECONDS=20

# Where downloaded docs + ZIPs land
DOWNLOAD_DIR=downloads

# Optional — enables Claude intent parsing + summary polish
# Leave blank to run fully deterministically (regex + template)
ANTHROPIC_API_KEY=

# Gmail OAuth credential files (defaults work if placed in the project root)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
